// Full waybar config for the Rubix compositor -- parity with the AwesomeWM
// wibar (bar.lua). Copy into ~/.config/waybar/ or run directly with -c/-s.
//
// All custom modules are persistent (continuous return-type json); they rely on
// Rubix delivering frame callbacks to layer surfaces (the layer send_frame fix)
// so their live updates actually repaint.
{
  // Watch the stylesheet and re-apply it in place. rubixTheme.py rewrites it on
  // every wallpaper change, and the alternative -- SIGUSR2 -- tears the bar down
  // and rebuilds it, which momentarily drops the layer surface's exclusive zone
  // and shoves every tiled window a few pixels.
  "reload_style_on_change": true,

  // Only the ultrawide gets a bar. Without this, waybar puts this same bar on
  // every connected output, including the 1280-wide portrait strip -- which is
  // the dashboard panel and already shows system stats of its own.
  //
  // That strip is where this bar breaks down. The module set below does not fit
  // its 1232px of usable width (1280 minus the two 24px margins), so waybar
  // stops pinning the bar to the output and sizes it to its content instead --
  // measured as wide as 1348px, wider than the screen. Every clock tick, CPU
  // sample and volume change then resizes the bar, each resize makes the
  // compositor re-configure the layer surface, and waybar leaks a file
  // descriptor set per rebuild. It stalls after a day or two: ~4300
  // reconfigures over two days on the strip, against 3 on DP-3.
  "output": "DP-3",

  "layer": "top",
  "position": "top",
  "height": 24,
  "margin-left": 24,
  "margin-right": 24,
  "spacing": 4,

  "modules-left": ["custom/waStatus", "custom/vramArbiter", "custom/wearRetrain"],
  "modules-center": ["custom/rubix"],
  "modules-right": ["cpu", "memory", "network", "custom/volume", "tray", "custom/clock"],

  // --- Left: the cube pips (Rubix's taglist analog) ---
  "custom/rubix": {
    "exec": "python3 ~/Projects/rubix/contrib/waybar/rubixBar.py",
    "return-type": "json",
    "escape": false,
    "restart-interval": 2
  },

  // --- Left: workAssistant status (REC / Transcribing / Notes) ---
  "custom/waStatus": {
    "exec": "python3 ~/Projects/rubix/contrib/waybar/waStatus.py",
    "return-type": "json",
    "escape": false,
    "restart-interval": 2
  },

  // --- Left: vramArbiter GPU status ---
  "custom/vramArbiter": {
    "exec": "python3 ~/Projects/dotfiles-tools/Scripts/vramArbiterBar.py",
    "return-type": "json",
    "escape": false,
    "restart-interval": 2
  },

  // --- Left: headphone wearable model retrain (click: train, right-click: promote) ---
  "custom/wearRetrain": {
    "exec": "python3 ~/Projects/dotfiles-tools/Scripts/wearRetrainBar.py",
    "return-type": "json",
    "escape": false,
    "restart-interval": 2,
    "on-click": "setsid -f ~/.local/share/gesturecontrol/venv/bin/python3 ~/gesturecontrol/tests/retrainWearable.py train",
    "on-click-right": "setsid -f ~/.local/share/gesturecontrol/venv/bin/python3 ~/gesturecontrol/tests/retrainWearable.py promote"
  },

  // --- Right: system stats via built-ins ---
  "cpu": {
    "interval": 2,
    "format": "⚙ {usage}%"
  },
  "memory": {
    "interval": 2,
    "format": "▦ {used:0.1f}G"
  },
  "network": {
    "interval": 2,
    "format-ethernet": "{bandwidthDownBytes} ↓ {bandwidthUpBytes} ↑",
    "format-wifi": "{bandwidthDownBytes} ↓ {bandwidthUpBytes} ↑",
    "format-disconnected": "no net",
    "tooltip-format": "{ifname}: {ipaddr}"
  },

  // --- Right: volume with grow/shrink animation ---
  "custom/volume": {
    "exec": "python3 ~/Projects/rubix/contrib/waybar/volume.py",
    "return-type": "json",
    "escape": false,
    "restart-interval": 2
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  // --- Right: date + time with ordinal suffix ---
  "custom/clock": {
    "exec": "python3 ~/Projects/rubix/contrib/waybar/clockOrdinal.py",
    "return-type": "json",
    "escape": false,
    "restart-interval": 2
  }
}
